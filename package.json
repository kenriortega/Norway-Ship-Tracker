{
  "name": "norway-ship-tracker",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev --workspace @norway-ship-tracker/web",
    "dev:ingestor": "cd apps/ingestor-go && go run ./cmd/ingestor",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "echo 'Las pruebas del worker viven en apps/ingestor-go: cd apps/ingestor-go && go test ./...' && npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace @norway-ship-tracker/db"
  },
  "engines": {
    "node": ">=20"
  }
}
