# Shared database (use a pooled PostgreSQL URL in Vercel)
DATABASE_URL=postgres://ship_tracker:ship_tracker@localhost:5433/ship_tracker

# Primary AIS provider
AIS_PROVIDER=barentswatch
BARENTSWATCH_CLIENT_ID=
BARENTSWATCH_CLIENT_SECRET=
BARENTSWATCH_SCOPE=ais
BARENTSWATCH_TOKEN_URL=https://id.barentswatch.no/connect/token
BARENTSWATCH_STREAM_URL=https://live.ais.barentswatch.no/v1/combined
BARENTSWATCH_LATEST_URL=https://live.ais.barentswatch.no/v1/latest/combined
# Histórico de 24 h que consume el proxy /api/vessels/[mmsi]/track
BARENTSWATCH_HISTORIC_URL=https://historic.ais.barentswatch.no/v1/historic/trackslast24hours
AIS_BOOTSTRAP_SNAPSHOT=true
AIS_HISTORY_SAMPLE_SECONDS=60
# Retención del histórico: días completos que se conservan además del día en
# curso, días de particiones aprovisionadas por delante y cada cuánto revisa
# el worker ambas cosas.
AIS_HISTORY_RETENTION_DAYS=3
AIS_PARTITION_AHEAD_DAYS=2
AIS_MAINTENANCE_INTERVAL_MINUTES=30
AIS_INITIAL_BACKOFF_MS=1000
AIS_MAX_BACKOFF_MS=30000
HEALTH_PORT=3001

# Legacy Kystverket TCP provider
KYSTVERKET_HOST=153.44.253.27
KYSTVERKET_PORT=5631
AIS_CONNECT_TIMEOUT_SECONDS=10
AIS_STALL_TIMEOUT_SECONDS=60
AIS_JITTER_PERCENT=20
AIS_CHANNEL_CAPACITY=1024

# Raw capture tool
CAPTURE_DIRECTORY=captures
CAPTURE_MAX_FILE_BYTES=67108864
CAPTURE_MAX_FILES=24
# CAPTURE_RUN_SECONDS=10

# Local PostgreSQL container
POSTGRES_DB=ship_tracker
POSTGRES_USER=ship_tracker
POSTGRES_PASSWORD=ship_tracker
POSTGRES_PORT=5433

